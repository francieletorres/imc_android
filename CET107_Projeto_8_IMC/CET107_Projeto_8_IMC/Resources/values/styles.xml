<?xml version="1.0" encoding="utf-8" ?>
<resources>
	<!-- Definição de estilo para a aplicação -->
	<style name="AppTheme" parent="android:Theme.Holo.Light.NoActionBar">

		<item name="android:colorBackground">@color/containerBackgColor</item>
		<item name="android:colorPrimary">@color/colorPrimary</item>
		<item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="android:colorAccent">@color/colorAccent</item>	
	</style>

	<!-- Definição de estilo para os subcontentores LinearLayout -->
	<style name="linLayoutCommonProperties">
		<item name="android:background">@drawable/backgdefault</item>
		<item name="android:padding">@dimen/padding</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:elevation">4dp</item>
		<item name="android:layout_marginBottom">@dimen/layoutMarginBottom</item>
		<item name="android:layout_marginTop">0dp</item>
		<item name="android:layout_marginLeft">10dp</item>
		<item name="android:layout_marginRight">10dp</item>
	</style>


	<!-- Definição de estilo para os TextViews -->
	<style name="tvCommonProperties">
		<item name="android:textSize">@dimen/text_title</item>
		<item name="android:textColor">@color/tvTextColor</item>
		<item name="android:background">@drawable/backginvert</item>
		<item name="android:padding">@dimen/padding</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginBottom">5dp</item>
		<item name="android:layout_marginTop">5dp</item>
		<item name="android:layout_marginLeft">0dp</item>
		<item name="android:layout_marginRight">5dp</item>	
	</style>

	<!-- Definição de estilo para os editTexts -->
	<style name="etCommonProperties">
		<item name="android:textSize">@dimen/text_title</item>
		<item name="android:textColor">@color/etTextColor</item>
		<item name="android:background">@drawable/backgdefault</item>
		<item name="android:padding">@dimen/padding</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginBottom">5dp</item>
		<item name="android:layout_marginTop">5dp</item>
		<item name="android:layout_marginLeft">0dp</item>
		<item name="android:layout_marginRight">0dp</item>
	</style>

	<!-- Definição de estilo para os buttons -->
	<style name="btCommonProperties">
		<item name="android:textSize">@dimen/text_title</item>
		<item name="android:textColor">@color/btTextColor</item>
		<item name="android:background">@drawable/backginvert</item>
		<item name="android:textFontWeight">500</item>
		<item name="android:gravity">center</item>
		<item name="android:padding">@dimen/padding</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:elevation">4dp</item>
		<item name="android:layout_marginBottom">@dimen/layoutMarginBottom</item>
		<item name="android:layout_marginTop">0dp</item>
		<item name="android:layout_marginLeft">10dp</item>
		<item name="android:layout_marginRight">10dp</item>
	</style>
	
</resources>

