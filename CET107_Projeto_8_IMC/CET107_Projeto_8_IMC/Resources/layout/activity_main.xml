<?xml version="1.0" encoding="utf-8"?>
	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:background="@color/containerBackgColor"
	android:padding="0dp">


		<android.widget.Toolbar
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/colorPrimary"
			android:padding="0dp"
			android:layout_marginBottom="@dimen/layoutMarginBottom"
			> 
			
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/app_name2"
				android:textColor="@android:color/white"
				android:textSize="@dimen/text_toolbar"
				android:gravity="center"
				/>
			</android.widget.Toolbar>

	<LinearLayout
		android:id="@+id/layoutPeso"
		android:padding="@dimen/padding"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_marginBottom="@dimen/layoutMarginBottom"
		android:layout_marginTop="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		> 
		
		<TextView
			android:id="@+id/tvPeso"
			android:text="Peso (Kg):"
			android:textSize="@dimen/text_title"
			android:textColor="@color/tvTextColor"
			android:background="@drawable/backginvert"
			android:padding="10dp"
			android:layout_width="0dp"
			android:layout_weight="6"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="5dp"
			/>

		<EditText
			android:id="@+id/etPeso"
			android:inputType="numberDecimal"
			android:textSize="@dimen/text_title"
			android:textColor="@color/etTextColor"
			android:background="@drawable/backgdefault"
			android:padding="10dp"
			android:layout_width="0dp"
			android:layout_weight="4"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
			/>
		
	</LinearLayout>

	<LinearLayout
		android:id="@+id/layoutAltura"
		android:padding="@dimen/padding"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_marginBottom="@dimen/layoutMarginBottom"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

		<TextView
			android:id="@+id/tvAltura"
			android:text="Altura (m):"
			android:textSize="@dimen/text_title"
			android:textColor="@color/tvTextColor"
			android:background="@drawable/backginvert"
			android:padding="10dp"
			android:layout_width="0dp"
			android:layout_weight="6"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="5dp"
		/>

		<EditText
			android:id="@+id/etAltura"
			android:inputType="numberDecimal"
			android:textSize="@dimen/text_title"
			android:textColor="@color/etTextColor"
			android:background="@drawable/backgdefault"
			android:padding="10dp"
			android:layout_width="0dp"
			android:layout_weight="4"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
		/>
	</LinearLayout>

	<Button
		android:id="@+id/btCalcular"
		android:text="Calcular"
		android:textFontWeight="500"
		android:gravity="center"
		android:textSize="@dimen/text_title"
		android:textColor="@color/btTextColor"
		android:background="@drawable/backginvert"
		android:padding="20dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="@dimen/layoutMarginBottom"
		android:layout_marginTop="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		android:elevation="4dp"
	/>

	<LinearLayout
		android:id="@+id/layoutIMC"
		android:padding="@dimen/padding"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_marginBottom="@dimen/layoutMarginBottom"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

			<TextView
				android:id="@+id/tvIMC"
				android:text="IMC(Kg/m^2):"
				android:textSize="@dimen/text_title"
				android:textColor="@color/tvTextColor"
				android:background="@drawable/backginvert"
				android:padding="10dp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginLeft="0dp"
				android:layout_marginRight="5dp"
		/>

			<EditText
				android:id="@+id/etIMC"
				android:inputType="none"
				android:gravity="center"
				android:editable="false"
				android:focusable="false"
				android:focusableInTouchMode="false"
				android:clickable="false"
				android:textSize="@dimen/text_title"
				android:textColor="@color/etTextColor"
				android:background="@drawable/backgdefault"
				android:padding="10dp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginLeft="0dp"
				android:layout_marginRight="0dp"
		/>
		</LinearLayout>

	</LinearLayout>