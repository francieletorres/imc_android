<?xml version="1.0" encoding="utf-8"?>
	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:background="@color/containerBackgColor"
	android:padding="0dp">


		<android.widget.Toolbar
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/colorPrimary"
			android:padding="0dp"
			android:layout_marginBottom="@dimen/layoutMarginBottom"
			> 
			
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/app_name2"
				android:textColor="@android:color/white"
				android:textSize="@dimen/text_toolbar"
				android:gravity="center"
				/>
			</android.widget.Toolbar>

	<LinearLayout
		android:id="@+id/layoutPeso"
		android:orientation="horizontal"
		style="@style/linLayoutCommonProperties"
		> 
		
		<TextView
			android:id="@+id/tvPeso"
			android:text="@string/sPeso"
			android:layout_width="0dp"
			android:layout_weight="6"
			style="@style/tvCommonProperties"
			/>

		<EditText
			android:id="@+id/etPeso"
			android:inputType="numberDecimal"
			android:layout_width="0dp"
			android:layout_weight="4"
			style="@style/etCommonProperties"
			/>
		
	</LinearLayout>

	<LinearLayout
		android:id="@+id/layoutAltura"
		android:orientation="horizontal"
		style="@style/linLayoutCommonProperties"
		>

		<TextView
			android:id="@+id/tvAltura"
			android:text="@string/sAltura"
			android:layout_width="0dp"
			android:layout_weight="6"
			style="@style/tvCommonProperties"
		/>

		<EditText
			android:id="@+id/etAltura"
			android:inputType="numberDecimal"
			android:layout_width="0dp"
			android:layout_weight="4"
			style="@style/etCommonProperties"
		/>
	</LinearLayout>

	<Button
		android:id="@+id/btCalcular"
		android:text="@string/sCalcular"
		style="@style/btCommonProperties"
	/>

	<Button
		android:id="@+id/btLimpar"
		android:text="@string/sLimpar"
		style="@style/btCommonProperties"
	/>

	<LinearLayout
		android:id="@+id/layoutIMC"
		android:orientation="vertical"
		style="@style/linLayoutCommonProperties"
		>

			<TextView
				android:id="@+id/tvIMC"
				android:text="@string/sIMC"
				android:layout_width="match_parent"
				style="@style/tvCommonProperties"
		/>

			<EditText
				android:id="@+id/etIMC"
				android:inputType="none"
				android:gravity="center"
				android:editable="false"
				android:focusable="false"
				android:focusableInTouchMode="false"
				android:clickable="false"
				android:layout_width="match_parent"
				style="@style/etCommonProperties"
		/>
		</LinearLayout>

	</LinearLayout>