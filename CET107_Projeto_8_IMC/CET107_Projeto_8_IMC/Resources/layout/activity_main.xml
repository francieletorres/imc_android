<?xml version="1.0" encoding="utf-8"?>
	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:background="#FFF"
	android:padding="10dp">


	<LinearLayout
		android:id="@+id/layoutPeso"
		android:padding="10dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_margin="6dp">
		
		<TextView
			android:id="@+id/tvPeso"
			android:text="Peso (Kg):"
			android:textSize="25sp"
			android:textColor="#FFF"
			android:background="@drawable/backginvert"
			android:padding="10dp"
			android:layout_width="150dp"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			/>

		<EditText
			android:id="@+id/etPeso"
			android:inputType="numberDecimal"
			android:textSize="25sp"
			android:textColor="#42BD65"
			android:background="@drawable/backgdefault"
			android:padding="10dp"
			android:layout_width="150dp"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			/>
		
	</LinearLayout>

	<LinearLayout
		android:id="@+id/layoutAltura"
		android:padding="10dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_margin="6dp">

		<TextView
			android:id="@+id/tvAltura"
			android:text="Altura (m):"
			android:textSize="25sp"
			android:textColor="#FFF"
			android:background="@drawable/backginvert"
			android:padding="10dp"
			android:layout_width="150dp"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
		/>

		<EditText
			android:id="@+id/etAltura"
			android:inputType="numberDecimal"
			android:textSize="25sp"
			android:textColor="#42BD65"
			android:background="@drawable/backgdefault"
			android:padding="10dp"
			android:layout_width="150dp"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp"
			android:layout_marginTop="5dp"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
		/>
	</LinearLayout>

	<Button
		android:id="@+id/btCalcular"
		android:text="Calcular"
		android:textFontWeight="500"
		android:gravity="center"
		android:textSize="25sp"
		android:textColor="#FFF"
		android:background="@drawable/backginvert"
		android:padding="20dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="5dp"
		android:layout_marginTop="5dp"
		android:layout_marginLeft="5dp"
		android:layout_marginRight="5dp"
	/>

	<LinearLayout
		android:id="@+id/layoutIMC"
		android:padding="10dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/backgdefault"
		android:elevation="4dp"
		android:layout_margin="6dp">

			<TextView
				android:id="@+id/tvIMC"
				android:text="IMC (Kg/m^2)"
				android:textSize="20sp"
				android:textColor="#FFF"
				android:background="@drawable/backginvert"
				android:padding="10dp"
				android:layout_width="150dp"
				android:layout_height="wrap_content"
				android:layout_marginBottom="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
		/>

			<EditText
				android:id="@+id/etIMC"
				android:inputType="none"
				android:editable="false"
				android:focusable="false"
				android:focusableInTouchMode="false"
				android:clickable="false"
				android:textSize="25sp"
				android:textColor="#42BD65"
				android:background="@drawable/backgdefault"
				android:padding="10dp"
				android:layout_width="150dp"
				android:layout_height="wrap_content"
				android:layout_marginBottom="5dp"
				android:layout_marginTop="5dp"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
		/>
		</LinearLayout>

	</LinearLayout>